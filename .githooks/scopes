# commit scope 封闭枚举 —— 唯一权威列表
#
# 规则:
#   1. commit message 首行必须带 scope，且只能从这里选，禁止自创近义词。
#   2. 新增 scope 必须和修改本文件放在同一个提交里，让"造新词"在 diff 里可见。
#   3. 拿不准时选改动的主要意图；跨模块或仓库级改动统一用 repo。
#   4. 一个 scope 对应一个模块（下列注释里的源码路径），改动落在哪个模块就选哪个；
#      同一提交同时动多个模块时，拆成多个提交，而不是找一个能"概括"的 scope。
#
# 格式: 每行一个 scope，# 开头为注释。hook 与 CI 都读这一份。

# ── 功能域（玩家可见的功能模块） ──
back         # 死亡返回：service/DeathBackManager、command/DeathBackCommand
warp         # 路径点：service/WarpManager、model/Warp、command/WarpCommand
tpa          # 玩家间传送请求：command/TpaCommand
safe-point   # 安全落点搜索：service/SafePointFinder
history      # 传送历史与回退：service/TeleportHistory（/warp tp back、/tpaback 共用）
update       # 更新检查：service/UpdateChecker、config.yml 的 update-checker 段

# ── 基础设施（被各功能域共用的层） ──
core         # 插件生命周期与装配：BringTeleportPlugin、线程池与调度
db           # 持久化层：表结构、SQL、连接与重试（SQLite）
command      # 命令注册、Tab 补全、帮助页：command/CommandManager、BringTeleportCommand
config       # 配置项定义、读盘与迁移：config/ConfigManager、config.yml
locale       # 语言文件与消息渲染：locale/LocaleManager、locales.yml
perm         # 权限节点：plugin.yml 与各命令的权限检查

# ── 工程 ──
build        # Gradle、打包、依赖版本
ci           # CI、Issue 模板、仓库配置

# ── 兜底 ──
repo         # 跨模块或仓库级改动（README、LICENSE、AGENTS.md 等）
